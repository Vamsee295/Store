# Shopify Storefront configuration
SHOPIFY_STORE_DOMAIN=thirdshelfstore.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=thirdshelfstore.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Cache revalidation
SHOPIFY_REVALIDATE_SECONDS=60
REVALIDATE_SECRET=

# Shopify webhook verification — configure only when required
SHOPIFY_WEBHOOK_SECRET=

# Managed Key-Value Storage (optional for Vercel/serverless; fallback uses HMAC-signed HTTP-only session state)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# FAVOURITES_SIGNING_SECRET=