# Shopify Storefront API integration (recommended for production)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_api_token
SHOPIFY_API_VERSION=2025-10

# Optional: set true only after the Shopify catalog is ready.
# Without credentials the storefront runs in clearly-labelled DEMO mode.
